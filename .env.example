# Copy this to .env and fill in your credentials

# Git user configuration
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=your.email+bot@example.com

# GitHub Personal Access Token (for repo access)
GITHUB_TOKEN=ghp_your_github_token_here

# Note: Claude credentials are mounted directly from ~/.claude.json and ~/.claude/
# Run `claude login` on your host or inside the container to authenticate