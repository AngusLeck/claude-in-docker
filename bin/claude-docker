#!/bin/bash
# claude-docker - Run Claude in a Docker container
# Routes to the appropriate script based on flags

set -e

# Resolve symlinks to get the actual script location
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    LINK_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$LINK_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

case "$1" in
    --uninstall)
        exec "$SCRIPT_DIR/claude-docker-uninstall"
        ;;
    --update)
        shift
        exec "$SCRIPT_DIR/claude-docker-update" "$@"
        ;;
    --ls)
        source "$ROOT_DIR/lib/sessions.sh"
        list_sessions
        exit 0
        ;;
    --attach)
        source "$ROOT_DIR/lib/sessions.sh"
        attach_session "${2:-}"
        ;;
    --pick)
        source "$ROOT_DIR/lib/sessions.sh"
        pick_session
        exit 0
        ;;
    --prune)
        source "$ROOT_DIR/lib/sessions.sh"
        prune_sessions "${2:-}"
        exit 0
        ;;
    --workspace|-w)
        echo "$ROOT_DIR/workspace"
        exit 0
        ;;
    -g|--global)
        shift
        exec "$SCRIPT_DIR/claude-docker-global" "$@"
        ;;
    --help|-h)
        echo "Usage: claude-docker [OPTIONS] [CLAUDE_ARGS...]"
        echo
        echo "Run Claude in a Docker container."
        echo
        echo "Modes:"
        echo "  (default)      Project mode - mount current directory"
        echo "  -g, --global   Global mode - persistent workspace"
        echo
        echo "Options:"
        echo "  -s, --shell    Open bash shell instead of claude"
        echo "  -d, --dangerous Run claude with --dangerously-skip-permissions"
        echo "  --docker       Mount the Docker socket into the container."
        echo "                 This is root-equivalent on the Docker VM - grant it"
        echo "                 only when the session needs docker (e.g. working on"
        echo "                 claude-in-docker itself)."
        echo "  -p, --publish PORT[:PORT]"
        echo "                 Publish a container port on 127.0.0.1 (project mode"
        echo "                 only, repeatable). Small ranges work too: -p 3000-3010."
        echo
        echo "Sessions:"
        echo "  --ls           List running sessions: attached (its terminal is open),"
        echo "                 detached (terminal closed, still running) or legacy"
        echo "                 (started before client tracking), and what Claude is"
        echo "                 doing (waiting for you first, then working, idle)"
        echo "  --pick         Choose a session with fzf: focuses an attached session's"
        echo "                 iTerm tab, attaches a detached one here, and resumes"
        echo "                 one that ended in the last 7 days"
        echo "  --prune [--yes]"
        echo "                 Stop detached (and unconfirmable legacy) sessions after"
        echo "                 asking; --yes skips the question"
        echo "  --attach <name|project>"
        echo "                 Reattach this terminal to a running project session."
        echo "                 Detach with Ctrl-Q Ctrl-Q; the session keeps running."
        echo "                 (Flags, not subcommands: \`claude attach\` and other"
        echo "                 claude subcommands still pass through.)"
        echo
        echo "Management:"
        echo "  --update [--no-cache] [branch]"
        echo "                 Update claude-docker and the Claude Code version in the"
        echo "                 image (--no-cache forces a full image rebuild)"
        echo "  --uninstall    Remove claude-docker"
        echo "  -w, --workspace Print global workspace path"
        echo
        echo "  --help, -h     Show this help"
        echo
        echo "Examples:"
        echo "  claude-docker              Run claude in current directory"
        echo "  claude-docker -g           Run claude in global workspace"
        echo "  claude-docker -s           Open shell in project container"
        echo "  claude-docker -g -s        Open shell in global container"
        echo "  claude-docker -d           Run claude in dangerous mode"
        echo "  claude-docker --docker     Run claude with Docker socket access"
        echo "  claude-docker -p 3000      View the container's :3000 at localhost:3000"
        echo "  claude-docker -p 3001:3000 Same, on host port 3001 (parallel sessions)"
        echo "  claude-docker --ls         See which sessions are running"
        echo "  claude-docker --attach my-app  Rejoin the session for ./my-app"
        echo "  claude-docker --pick       Jump to the session that needs you"
        echo "  claude-docker --prune      Clean up sessions left behind by closed tabs"
        echo "  cd \$(claude-docker -w)     Navigate to global workspace"
        echo "  cursor \$(claude-docker -w) Open workspace in IDE"
        exit 0
        ;;
    *)
        exec "$SCRIPT_DIR/claude-docker-project" "$@"
        ;;
esac
