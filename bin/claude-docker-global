#!/bin/bash
# claude-docker-global - Run Claude in global/workspace mode
# Long-running container with persistent workspace

set -e

# Get directory where this script lives, resolving symlinks.
# - BASH_SOURCE[0]: path used to invoke this script (may be a symlink)
# - dirname: extracts the directory portion
# - cd && pwd: resolves to absolute path, following symlinks
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

source "$ROOT_DIR/lib/flags.sh"
source "$ROOT_DIR/lib/container.sh"
source "$ROOT_DIR/lib/credentials.sh"

CONTAINER_NAME="claude-docker-global"

parse_mode_flags "$@"
set -- "${REMAINING_ARGS[@]}"

# Publishing is per-run but the global container is long-lived: a running
# container can't gain ports, so -p doesn't fit this mode.
if [[ ${#PUBLISH_PORTS[@]} -gt 0 ]]; then
    echo "Error: -p/--publish only applies to project mode."
    echo "The global container has no published ports; use a project-mode session"
    echo "(cd into the repo and run: claude-docker -p <port>) to view an app from the host."
    exit 1
fi

# Determine which env file to use
if [[ -f "$ROOT_DIR/.env" ]]; then
    ENV_FILE="$ROOT_DIR/.env"
else
    echo "Error: No credentials found."
    echo "Either run 'install.sh' or create a .env file in $ROOT_DIR"
    exit 1
fi

cd "$ROOT_DIR/docker"

# Detect Claude credentials at runtime
detect_claude_credentials

COMPOSE_FILES=(-f compose.base.yml -f compose.global.yml)
if $DOCKER_SOCK_MODE; then
    COMPOSE_FILES+=(-f compose.docker-sock.yml)
fi

# Ensure container is running
if ! container_running; then
    echo "Starting global Claude container..."
    docker compose "${COMPOSE_FILES[@]}" --env-file "$ENV_FILE" up -d
    sleep 2
elif $DOCKER_SOCK_MODE; then
    echo "Note: --docker only takes effect when the global container is created."
    echo "To apply it: docker rm -f $CONTAINER_NAME && claude-docker -g --docker"
fi

run_in_container "$@"
