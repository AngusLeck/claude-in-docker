#!/bin/bash
# claude-docker-update - Update claude-docker and the Claude Code version in its image
#
# Usage: claude-docker --update [--no-cache] [branch]
#
# Fetches the latest claude-in-docker, rebuilds the image with the latest Claude
# Code release (only the Claude Code layer rebuilds unless --no-cache is given),
# reinstalls the scripts, and offers to recreate the global container so it
# picks up the new image.
set -e

INSTALL_DIR="$HOME/.claude-in-docker"
REPO_URL="https://github.com/AngusLeck/claude-in-docker.git"
BRANCH="master"
TEMP_DIR="/tmp/claude-docker-update-$$"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-cache)
            export CLAUDE_DOCKER_BUILD_NO_CACHE=1
            shift
            ;;
        -*)
            echo "Error: unknown option '$1'" >&2
            echo "Usage: claude-docker --update [--no-cache] [branch]" >&2
            exit 1
            ;;
        *)
            BRANCH="$1"
            shift
            ;;
    esac
done

echo "================================"
echo "  Claude-in-Docker Update"
echo "================================"
echo

# Cleanup on exit
cleanup() {
    rm -rf "$TEMP_DIR" 2>/dev/null || true
}
trap cleanup EXIT

# Check for git
if ! command -v git &>/dev/null; then
    echo "Error: git is required for updates"
    exit 1
fi

# Clone latest version
echo "Fetching latest version (branch: $BRANCH)..."
if ! git clone --depth 1 --branch "$BRANCH" "$REPO_URL" "$TEMP_DIR"; then
    echo "Error: Failed to clone repository"
    exit 1
fi
echo

# Run install script (it reads credentials from $INSTALL_DIR/.env and keeps
# them unless you choose to overwrite)
echo "Running installer..."
echo
cd "$TEMP_DIR"
./install.sh

# Cleanup happens via trap
